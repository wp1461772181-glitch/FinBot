[Unit]
Description=FinBot API (uvicorn, in-process background loops)
After=finbot-tunnel-db.service finbot-tunnel-mac.service
Wants=finbot-tunnel-db.service finbot-tunnel-mac.service
[Service]
WorkingDirectory=/home/hatch/workspace/projects/FinBot
EnvironmentFile=/home/hatch/workspace/projects/FinBot/.env
EnvironmentFile=/etc/finbot/muse.env
EnvironmentFile=/etc/finbot/proxy.env
Environment=DB_POOL_SIZE=10 DB_MAX_OVERFLOW=10 BACKGROUND_LOOPS=true
ExecStart=/home/hatch/workspace/projects/FinBot/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
MemoryMax=1500M
[Install]
WantedBy=multi-user.target

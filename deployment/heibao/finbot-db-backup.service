[Unit]
Description=FinBot database backup (pg_dump of finbot-postgres, optional finbot-pgvector)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
# 可选：PGVECTOR_DB_USER / PGVECTOR_DB_NAME / BACKUP_ALERT_CMD 等覆盖项
EnvironmentFile=-/opt/finbot/backup.env
ExecStart=/opt/finbot/bin/finbot-db-backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1800

export type AnswerVerdict = "good" | "bad";
type Storage = Pick<globalThis.Storage, "getItem" | "setItem" | "removeItem"> | null | undefined;
type Rated = { role?: string; id?: string; turn_id?: string; feedback?: { verdict?: string | null; reason?: string | null } | null };
export const LOCAL_PREFIX: string;
export const VERDICTS: AnswerVerdict[];
export const THUMBS: { verdict: AnswerVerdict; label: string }[];
export const REASON_MAX: number;
export const REASON_PLACEHOLDER: string;
export const FAILED_TEXT: string;
export function localKey(turnId: string): string;
export function localVerdict(value: unknown): AnswerVerdict | null;
export function readLocal(storage: Storage, turnId: string | null | undefined): AnswerVerdict | null;
export function serverVerdict(message: Rated | null | undefined): AnswerVerdict | null;
export function nextVerdict(current: AnswerVerdict | null, pressed: AnswerVerdict): AnswerVerdict | null;
export function asksReason(current: AnswerVerdict | null, pressed: AnswerVerdict): boolean;
export function cleanReason(text: unknown): string | null;
export function feedbackBody(verdict: AnswerVerdict, reason?: string | null): { verdict: AnswerVerdict; reason?: string };
export function uploadFor(message: Rated | null | undefined, storage: Storage): AnswerVerdict | null;
export function forgetLocal(storage: Storage, turnId: string): void;
export function toggleLocal(storage: Storage, turnId: string, pressed: AnswerVerdict): AnswerVerdict | null;

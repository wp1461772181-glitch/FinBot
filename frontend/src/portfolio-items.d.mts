export type Tone = "gain" | "loss" | "flat" | "none";
export type PortfolioEntryForm = { kind: string; symbol: string; quantity: string; price: string; fee: string; amount: string; ratio: string; occurred_on: string; note: string };
export type PortfolioPlanForm = { plan_text: string; add_price: string; stop_price: string; target_price: string };
export const KIND_LABELS: Record<string, string>;
export const ENTRY_KINDS: string[];
export const WARNING_LABELS: Record<string, string>;
export function formatMoney(value: unknown, options?: { signed?: boolean; places?: number; dash?: string }): string;
export function formatPercent(value: unknown, options?: { signed?: boolean; places?: number; dash?: string }): string;
export function formatShares(value: unknown): string;
export function formatPrice(value: unknown): string;
export function pnlTone(value: unknown): Tone;
export function parseAmount(text: unknown, options?: { allowNegative?: boolean }): string | null;
export function blankEntry(kind?: string): PortfolioEntryForm;
export function entryBody(form: PortfolioEntryForm): { body: Record<string, string> } | { error: string };
export function entryDetail(tx: { kind: string; quantity?: string | null; price?: string | null; amount?: string | null; ratio?: string | null }): string;
export function entryLine(tx: { kind: string; quantity?: string | null; price?: string | null; fee?: string | null; amount?: string | null; ratio?: string | null }): string;
export function planForm(plan: { plan_text?: string; add_price?: string | null; stop_price?: string | null; target_price?: string | null } | null | undefined): PortfolioPlanForm;
export function planBody(form: PortfolioPlanForm): { body: { plan_text: string; add_price: string | null; stop_price: string | null; target_price: string | null } } | { error: string };
export function planChanged(plan: Parameters<typeof planForm>[0], form: PortfolioPlanForm): boolean;
export function warningLabels(codes: string[] | null | undefined): string[];

export type RuleStatus = { kind: string; label: string; active: boolean };
export type PresetLevel = { level: string; label: string; threshold: number; text: string };
export type PresetRow = { key: string; title: string; text: string; enabled: boolean; hard: boolean; editable: boolean; levels: PresetLevel[] | null; unit: string; canEdit: boolean; canReset: boolean; yields: string[]; applies: string[] | string };
export type RuleRow = { id: string; symbol: string; text: string; status: RuleStatus; fired: boolean; lastFired: string; override: string | true | "" };
export type Sensitivity = "quiet" | "standard" | "sensitive";
export type SettingsView = { sensitivity: Sensitivity; shortMoves: boolean; choices: Array<{ value: Sensitivity; label: string; words: string }> };
export const SENSITIVITIES: ReadonlyArray<readonly [Sensitivity, string]>;
export function plainNum(value: unknown): string;
export function ruleStatus(raw: unknown): RuleStatus;
export function sigmaPair(value: unknown): [number, number] | null;
export function sigmaWords(value: unknown, locale?: string): string;
export function settingsView(settings: unknown, locale?: string): SettingsView;
export function thresholdUnit(key: string): "%" | "x" | "days" | "";
export function presetRows(presets: unknown): PresetRow[];
export function yieldsLine(symbols: unknown, locale?: string): string;
export function appliesText(applies: unknown, locale?: string): string;
export function ruleRows(rules: unknown): RuleRow[];
export function checkThresholds(key: string, levels: Array<{ level: string }>, inputs: string[]): { levels: Array<{ threshold: number; level: string }> } | { error: string };
export function watchWriteError(status: number | undefined, detail?: unknown): string;

export type BadgeStatus = { label: string; kind: string };
export type Cost = { kind: "amount" | "unpriced" | "pending" | "unrecorded" | "none"; amount: string };
export type AnswerFilters = { botId: string; engine: string; status: string; highTier: boolean; slow: boolean; q: string; before: string };
export type AnswerRow = { id: string; time: string; bot: string; question: string; status: BadgeStatus; tier: string; time_taken: string; calls: string; tokens: string; cost: Cost; old_engine: boolean };
export type TimelineStep = {
  kind: "question" | "narration" | "model" | "tool" | "card" | "card_result" | "answer";
  title: string; text?: string; tier?: string; purpose?: string; attempt?: number; ok?: boolean; error?: string; ms?: string; tokens?: string; cost?: Cost; time?: string;
  offset?: string; done_offset?: string; name?: string; arguments?: string; state?: string | BadgeStatus | null; result?: string; targets?: string[]; choices?: string[];
};
export type UsageRow = { key: string; label: string; calls: string; failed: string; input: string; output: string; cache: string; p50: string; cost: Cost; missing: string[]; unpriced_calls: number };
export type OperationRow = { id: string; time: string; bot: string; what: string; detail: string; status: BadgeStatus; decided_at: string; result: string };
export type DeliveryRow = { id: string; time: string; source: string; channel: string; status: BadgeStatus; acked: string; text: string };

export type Words = { t: (phrase: string) => string; colon: string; comma: string; list: string; parens: (value: string) => string };
export const ZH_WORDS: Readonly<Words>;
export const ANSWER_FILTER_DEFAULTS: Readonly<AnswerFilters>;
export const ANSWER_ENGINES: { value: string; label: string }[];
export const ANSWER_STATUSES: string[];
export const USAGE_GROUPS: { value: string; label: string }[];
export const USAGE_PRESETS: number[];
export function formatMs(ms: unknown): string;
export function formatTokens(count: unknown): string;
export function formatUsd(value: unknown): string;
export function costCell(cost: unknown, hadCalls: boolean, state?: string): Cost;
export function formatTime(value: unknown, timeZone?: string): string;
export function tierLabel(tier: unknown): string;
export function answerStatus(status: unknown): BadgeStatus;
export function answersQuery(filters: Partial<AnswerFilters>): string;
export function pagedQuery(before: string | null | undefined): string;
export function slowRuleText(thresholdMs: unknown, w?: Words): string;
export function answerRow(item: unknown, timeZone?: string, w?: Words): AnswerRow;
export function answerNotes(detail: unknown, w?: Words): { kind: string; text: string }[];
export function detailTimeline(detail: unknown, timeZone?: string, w?: Words): TimelineStep[];
export function usageRange(days: number, today: string): { from: string; to: string };
export function usageQuery(options: { from?: string; to?: string; group?: string }): string;
export function usageGroupLabel(group: string, row: unknown, w?: Words): string;
export function usageRow(group: unknown, name: string, w?: Words): UsageRow;
export function usageTotalsRow(totals: unknown, w?: Words): UsageRow;
export function operationStatus(item: { status?: unknown; expired?: unknown; decided_at?: unknown }): BadgeStatus;
export function operationRow(item: unknown, timeZone?: string, w?: Words): OperationRow;
export function deliveryRow(item: unknown, timeZone?: string, w?: Words): DeliveryRow;

export type DetailSection = "versions" | "evaluation" | "audit";
export const DETAIL_SECTIONS: DetailSection[];
export const SECTION_PHRASE: Record<DetailSection, string>;
export const MAX_REVISION_SOURCES: number;
export function detailSection(value: unknown): DetailSection;
export type VersionMethodKey = "initial" | "manual" | "monitor" | "update";
export function versionMethod(entry: { parent_version_id?: string | null; trigger_type?: string | null } | null | undefined): { key: VersionMethodKey; phrase: string };
export type SourceDiff = { total: number; added: number; replaced: number; removed: number; inherited: number; hasParent: boolean };
export function sourceDiff(current: { evidence_version_manifest?: Array<Record<string, unknown>> } | null | undefined, parent: { evidence_version_manifest?: Array<Record<string, unknown>> } | null | undefined): SourceDiff;
export function targetExpired(target: unknown, today: string): boolean | null;
export function reviseGate(target: unknown, today: string): { allowed: boolean; reason: string | null };
export function modelChangedIds<V extends { id: string; parent_version_id: string | null }, D>(versions: V[], details: Map<string, D>, changed: (current: D, parent: D) => boolean): Set<string>;
export type CandidateOption = { key: string; source_type: string; source_id: string; revisionType: string };
export function candidateGroupId(category: string): "new" | "backfilled" | "reanalyzed" | "status";
export function candidateGroups<T extends CandidateOption>(options: T[]): Array<{ id: "new" | "backfilled" | "reanalyzed" | "status"; phrase: string; items: T[] }>;
export function toggleSource(keys: string[], key: string, max?: number): string[];
export function sourceDisabled(keys: string[], key: string, max?: number): boolean;
export function pickedSources<T extends CandidateOption>(options: T[], keys: string[]): T[];
export function revisionRefs<T extends CandidateOption>(options: T[], keys: string[]): Array<Pick<T, "source_type" | "source_id">>;
export function reviseTarget<T extends CandidateOption>(options: T[], sourceIdLower: string | null | undefined): T | null;
export const REVISE_STEPS: Array<"parent" | "materials" | "confirm">;
export function canContinue(step: string, state: { picked: number }): boolean;

DATABASE_URL=postgresql+psycopg://market_evidence:market_evidence_dev@localhost:55432/market_evidence
# Set this only in your untracked local .env file. Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# OpenRouter Decisions API; keep the real value only in the ignored .env.
OPENROUTER_API_KEY=
# Safe default (research brief only, no probabilities); set llm to use the model chosen under "Forecast model" in settings.
FORECAST_DECISION_MODE=research_only
# Use your own reachable address. Keep the actual value in the ignored .env.
SEC_EDGAR_USER_AGENT=
# Only enable public mode when exposing FastAPI through a public HTTPS tunnel.
# Keep the actual access key in the ignored local .env file; never put it in VITE_*.
PUBLIC_API_MODE=false
APP_API_ACCESS_KEY=
CORS_ALLOWED_ORIGINS=

# Optional: hang guards, not budgets (Levi 2026-10-28: only a real fault stops a turn).  How long one request to the
# model service may take (seconds, 10-600) and how long a streamed answer may stay silent (seconds, 30-1200), and how
# long one web_research call may run (seconds, 5-300) / one knowledge retrieval may run.
# AGENT_PROVIDER_TIMEOUT_SECONDS=180
# AGENT_PROVIDER_STREAM_SECONDS=600
# WEB_RESEARCH_TIMEOUT_SECONDS=120
# KNOWLEDGE_RETRIEVAL_TIMEOUT_SECONDS=60

# Optional: how much of the earlier conversation a turn carries (KB, 16-128, default 64).  The request guard
# (twice this) and the per-turn token allowance for history follow it.  See docs/agent-context.md.
# AGENT_CONTEXT_BUDGET_KB=64

# Optional: how hard an OpenRouter reasoning model thinks per call (minimal, low, medium, high; "default" leaves
# it to the model).  Low keeps a multi-call agent turn from taking minutes.  Provider anthropic follows it too (none and minimal mean low); other providers are unaffected.
# AGENT_REASONING_EFFORT=low
# Provider "siliconflow": thinking per model.  DeepSeek-V4-Flash/Pro and GLM-5.2 get reasoning_effort high|max (lower tiers send
# nothing); Qwen3-8B/14B/32B/30B-A3B/235B-A22B, DeepSeek-V3.2, Hunyuan-A13B, GLM-4.5V/4.6V/5V-Turbo get enable_thinking +
# thinking_budget; any other model gets nothing.  off = nothing is sent for any SiliconFlow model (the old behaviour).
# FINBOT_SF_EFFORT=on

# Provider "anthropic" (native Messages API, app/anthropic_native.py).  The Python package must be installed on the box first:
#   pip install anthropic==2.12.0 docstring_parser==0.18.0 && python -c "import anthropic"
# on = native Messages API (default); off = the compatible endpoint again (needs no package; ignores effort, no caching).
# FINBOT_ANTHROPIC_NATIVE=on
# Only for an API key that is NOT scoped to one workspace (a personal / service-account key spanning workspaces): wrkspc_...
# A missing id shows up as the error code provider_workspace_required.
# FINBOT_ANTHROPIC_WORKSPACE_ID=
# Thinking blocks in the history: strip (default: send none) | drop_block (send them, the API drops stale ones; beta header) | off (send them, no control).
# FINBOT_ANTHROPIC_THINKING_BINDING=strip

# Claim + source-quote gate for agent chat answers. off | shadow | enforce. Default off.
# Shadow audits bind rate, latency, and answer quality while the legacy prose guards still decide.
# Recommended deploy value is shadow (the code default stays off when the variable is unset).
CLAIM_QUOTE_GATE=shadow
# CLAIM_QUOTE_MIN_CHARS=24
# LEGACY_PROSE_GUARDS=on
# Claim-support Jev (jev-claim-support-v4) only checks quotes in chat answers; Jev no longer forecasts.
# off | shadow | enforce. Code default off; recommended deploy value is shadow. Do not set enforce until labelled metrics are in docs/reports/.
# One attempt, timeout at most 5 seconds. See docs/claim-support-label-protocol.md.
CLAIM_JEV_SUPPORT=shadow
# CLAIM_JEV_SUPPORT_THRESHOLD=0.7
# CLAIM_JEV_TIMEOUT_SECONDS=5
# CLAIM_JEV_MAX_ATTEMPTS=1
# CLAIM_JEV_MAX_PER_TURN=4
# Server-wide daily cap on claim-support calls; unset means no cap.
CLAIM_JEV_DAILY_CAP=200
# CLAIM_JEV_DAILY_PATH=artifacts/claim-jev-daily.json

# Configured-news search: the refresh before a search (refresh_first) waits at most this many seconds, then searches the stored news
# and says so in meta.refresh_note.  The whole search tool call is cut off at the second limit (tool_timeout).
# FINBOT_NEWS_REFRESH_BOUND=on switches both limits (off = the old unbounded wait).
# FINBOT_NEWS_REFRESH_TIMEOUT_SECONDS=15
# FINBOT_NEWS_SEARCH_TOOL_TIMEOUT_SECONDS=30
# The API's background loops (BACKGROUND_LOOPS=true) also poll the configured news sources every 15 minutes; off = the library is
# refreshed only when a chat turn asks for it (the old behaviour).
# FINBOT_NEWS_BACKGROUND_POLL=on

# The three steps before the answer (resolve the reference, classify, general-knowledge answer) each read their own, smaller view of
# the conversation instead of the whole layered history: the newest continuous run that fits, with a note of how many earlier messages
# were left out.  off = every step carries the whole history as before.  Budgets are in KB (4-512; anything else = the default) and
# never exceed the history budget itself.  The reference step also keeps only the newest answers of its two catalogues.
# FINBOT_STAGE_CONTEXT_BUDGET=on
# FINBOT_STAGE_RESOLVER_HISTORY_KB=96
# FINBOT_STAGE_CLASSIFIER_HISTORY_KB=32
# FINBOT_STAGE_ANSWER_HISTORY_KB=48
# FINBOT_STAGE_RESOLVER_ITEMS_KB=24
# FINBOT_STAGE_RESOLVER_CITATIONS_KB=24

# 8-K earnings press release (Exhibit 99.1): find it by SEC's official file type (EX-99.1 in the accession's -index-headers.html)
# instead of guessing from the file name; the file-name pattern stays as the fallback.  A fetch_sec of an 8-K whose earlier
# attachment lookup found nothing now looks again.  off = file-name pattern only, no re-lookup.
# FINBOT_SEC_EXHIBIT_BY_TYPE=on

# fetch_sec with an accession_number the model named is no longer vetoed by the turn's financial_only scope (10-K/10-Q only);
# a named non-10-K/10-Q form without an accession answers sec_form_outside_scope instead of "not found".  off = the old behaviour.
# FINBOT_SEC_FETCH_NAMED_FORM=on
